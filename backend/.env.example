# Production / Staging Environment Variables for FranchiseBridge Backend
NODE_ENV=production
PORT=5000

# Cloud MongoDB Connection URI (e.g., from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/franchisebridge?retryWrites=true&w=majority

# Security Secrets (generate random long strings in production)
JWT_SECRET=super_secret_jwt_signing_key_franchisebridge_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_franchisebridge_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=franchisebridge_secure_cookie_secret_key

# Frontend Client URL (for CORS and cookie authorization)
CLIENT_URL=https://your-franchisebridge-frontend.vercel.app

# Local File Uploads Directory
UPLOAD_DIR=./uploads
