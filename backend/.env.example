# ==============================================================================
# FranchiseBridge Backend Environment Configuration
# Use this template for local development, staging, and Render production
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Render automatically provides process.env.PORT)
PORT=5000

# Cloud MongoDB Atlas Connection URI
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/franchisebridge?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/franchisebridge?retryWrites=true&w=majority

# MongoDB Connection Pool Sizing
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=50

# ------------------------------------------------------------------------------
# Security Secrets (Must be at least 32 characters in production)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_franchisebridge_2026_at_least_32_chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_franchisebridge_2026_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=franchisebridge_secure_cookie_secret_key_16_chars_min

# ------------------------------------------------------------------------------
# Frontend / Client Origin Configuration (CORS & Cookie Auth)
# ------------------------------------------------------------------------------
CLIENT_URL=https://your-franchisebridge-frontend.vercel.app
ALLOWED_ORIGINS=https://your-franchisebridge-frontend.vercel.app,http://localhost:3000,http://localhost:3004

# ------------------------------------------------------------------------------
# Object Storage Driver Configuration
# Options:
#   'local' : Stores files in ./private_storage/documents and ./uploads (default for dev)
#   's3'    : Real AWS S3 cloud storage for production (Required for Render ephemeral disks)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3

# AWS S3 Bucket & Region Configuration
AWS_S3_BUCKET=franchisebridge-production-vault
AWS_REGION=ap-south-1

# AWS Credentials (Optional if using AWS IAM Roles / Task Execution Roles)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Custom S3-Compatible Endpoint (Optional: For MinIO, LocalStack, Cloudflare R2)
# AWS_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Presigned Download URLs Policy ('true' | 'false')
# When false (default), all downloads are forced to stream through the authenticated backend gateway
ALLOW_PRESIGNED_URLS=false

# ------------------------------------------------------------------------------
# Local Upload Fallback Directory (Used when STORAGE_DRIVER=local)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Production SMTP / Email Notification Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password
SMTP_SECURE=false
FROM_EMAIL=notifications@franchisebridge.com

# ------------------------------------------------------------------------------
# Logging Level ('debug' | 'info' | 'warn' | 'error')
# ------------------------------------------------------------------------------
LOG_LEVEL=info
