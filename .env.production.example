# ==============================================================================
# FranchiseBridge Enterprise - Production Environment Variable Specification
# Copy this file to .env.production and populate with your production credentials.
# DO NOT COMMIT .env.production TO SOURCE CONTROL.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# Primary Production MongoDB URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/franchisebridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/franchisebridge

# Database Connection Pool Tuning
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5

# Security & Authentication Secrets
# Generate via: openssl rand -hex 32 (Must be at least 32 characters long)
JWT_SECRET=replace_with_64_character_hex_string_generated_via_openssl
JWT_REFRESH_SECRET=replace_with_separate_64_character_hex_string_via_openssl
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_at_least_32_character_cookie_signing_secret

# Production Domain & CORS Allowed Origins (Comma-separated)
CLIENT_URL=https://franchisebridge.com
ALLOWED_ORIGINS=https://franchisebridge.com,https://app.franchisebridge.com,https://admin.franchisebridge.com

# File Storage Configuration
# Options: 'local' (writes to private_storage/documents) or 's3' (AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
AWS_S3_BUCKET=franchisebridge-vault-production
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_ENDPOINT=

# Transactional Email (SMTP Service e.g. Amazon SES, SendGrid, Resend, or Mailgun)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
FROM_EMAIL=notifications@franchisebridge.com

# Logging & Monitoring
LOG_LEVEL=info
