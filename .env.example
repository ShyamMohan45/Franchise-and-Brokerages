# -----------------------------------------------------------------------------
# FranchiseBridge Environment Variables Configuration Template
# -----------------------------------------------------------------------------

# Backend Settings (backend/.env)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/franchisebridge
JWT_SECRET=franchisebridge_jwt_super_secret_development_key
JWT_REFRESH_SECRET=franchisebridge_jwt_refresh_development_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
COOKIE_SECRET=franchisebridge_cookie_signing_secret
UPLOAD_DIR=./uploads

# Frontend Settings (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
